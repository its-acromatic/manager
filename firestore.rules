rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Attendance documents: new structured shape
    match /users/{userId}/attendance/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == userId
        // required fields
        && request.resource.data.keys().hasAll(['date','status'])
        // date must be a string (YYYY-MM-DD)
        && request.resource.data.date is string
        // status must be one of the allowed enums
        && request.resource.data.status in ['present','absent','off','holiday','vacation','unmarked']
        // meta, if provided, must be a map
        && (!request.resource.data.keys().hasAny(['meta']) || request.resource.data.meta is map);
    }

    // Session settings for a user
    match /users/{userId}/settings/session {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['start','end','requiredPercent'])
        && request.resource.data.start is string
        && request.resource.data.end is string
        && request.resource.data.requiredPercent is number
        && request.resource.data.requiredPercent >= 0
        && request.resource.data.requiredPercent <= 100;
    }

    // Events: simple title+date
    match /users/{userId}/events/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        // only allow these keys (optional fields allowed)
        && request.resource.data.keys().difference(['title','date','description','startTime','endTime']).size() == 0
        && request.resource.data.title is string
        && request.resource.data.date is string
        && (!request.resource.data.keys().hasAny(['description']) || request.resource.data.description is string)
        && (!request.resource.data.keys().hasAny(['startTime']) || request.resource.data.startTime is string)
        && (!request.resource.data.keys().hasAny(['endTime']) || request.resource.data.endTime is string);
    }

    // Notes: simple text field
    match /users/{userId}/notes/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAny(['text'])
        && request.resource.data.text is string;
    }

    // Allow other subcollections of a user only to their owner
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny anything else by default
    match /{document=**} { allow read, write: if false; }
  }
}
